---
// Extends Starlight's default <Head> with one JSON-LD @graph per page.
//
// Everything in the graph is read from the page itself — the frontmatter title
// and description (which are also the visible <h1> and the <meta name=
// "description">) and the same `lastUpdated` Date the visible "Last updated"
// line renders — so the structured data cannot say something the page does not.
// Nothing here is hand-typed per page, and there is deliberately no
// aggregateRating/review: we have no reviews to describe.
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const { entry, lastUpdated } = route;

// Starlight synthesises a route whose entry id is '404' for the not-found page.
// It has no content, no date and nothing worth citing, so it gets no structured
// data — a TechArticle whose headline is "404" is noise in the graph — and an
// explicit noindex so a crawler that reaches it does not index an error page.
const isNotFound = entry.id === '404';

const SITE = 'https://docs.patchrelease.com';
const MARKETING = 'https://patchrelease.com';

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageUrl = `${SITE}${pathname}`;

const title = entry.data.title;
const description = entry.data.description ?? '';
const dateModified = lastUpdated instanceof Date ? lastUpdated.toISOString() : undefined;

const organization = {
  '@type': 'Organization',
  '@id': `${MARKETING}/#org`,
  name: 'Patch',
  url: `${MARKETING}/`,
  logo: `${MARKETING}/assets/patch-icon-512.png`,
  sameAs: [
    'https://github.com/patch-release/patch-swift',
    'https://github.com/patch-release/homebrew-tap',
    'https://github.com/patch-release',
    `${SITE}/`,
  ],
};

const article = {
  '@type': ['TechArticle', 'Article'],
  '@id': `${pageUrl}#article`,
  headline: title,
  name: title,
  ...(description ? { description } : {}),
  inLanguage: 'en',
  ...(dateModified ? { dateModified } : {}),
  author: { '@id': organization['@id'] },
  publisher: { '@id': organization['@id'] },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE}/#site`,
    name: 'Patch Docs',
    url: `${SITE}/`,
  },
  about: {
    '@type': 'SoftwareApplication',
    '@id': `${MARKETING}/#app`,
    name: 'Patch',
    operatingSystem: 'iOS 16+',
    applicationCategory: 'DeveloperApplication',
  },
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement:
    pathname === '/'
      ? [{ '@type': 'ListItem', position: 1, name: 'Patch Docs', item: `${SITE}/` }]
      : [
          { '@type': 'ListItem', position: 1, name: 'Patch Docs', item: `${SITE}/` },
          { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
        ],
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [article, breadcrumb, organization],
};

// A literal `</script` inside a JSON string would close this element early.
const jsonLd = JSON.stringify(graph).replace(/<\/script/gi, '<\\/script');
---

<Default><slot /></Default>
{
  isNotFound ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  )
}
